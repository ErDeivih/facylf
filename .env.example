# Supabase — proyecto de la web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo en el worker de ingesta (GitHub Actions). NUNCA en apps/web.
SUPABASE_SERVICE_ROLE_KEY=

# Identidad del bot frente a la federación. Ver packages/ingesta/src/cliente.ts.
# Los dos valores tienen que ser reales: una URL que explique qué hace el bot
# y un correo al que se pueda escribir. Sin esto el cliente se niega a arrancar.
BOT_URL=
BOT_CONTACTO=
