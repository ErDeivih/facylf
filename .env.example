# PostgreSQL canónico local. Copia este fichero como .env y usa contraseñas distintas.
POSTGRES_PASSWORD=
DATABASE_URL_LECTOR=postgres://facylf_lector:CAMBIAR@127.0.0.1:5433/facylf
# Páginas con cuenta (Mi panel, avisos, Mi cuenta, administración): rol facylf_app (0050). Hereda la lectura
# pública, no escribe en core y no puede hacerse pasar por el lector. Sin esta variable, esas páginas dicen
# que falta y no se inventan datos.
DATABASE_URL_APP=postgres://facylf_app:CAMBIAR@127.0.0.1:5433/facylf
DATABASE_URL_PUBLICADOR=postgres://facylf_publicador:CAMBIAR@127.0.0.1:5433/facylf
DATABASE_URL_MIGRACION=postgres://facylf_admin:CAMBIAR@127.0.0.1:5433/facylf
REVALIDACION_SECRETO=

# Identidad opcional para el cliente antiguo de packages/ingesta. Los recolectores locales actuales
# se configuran mediante perfiles/ y sus tareas programadas.
BOT_URL=
BOT_CONTACTO=
