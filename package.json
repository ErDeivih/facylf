{
  "name": "futbol-salamanca",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @facylf/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:dominio": "pnpm --filter @facylf/dominio test",
    "ingesta:una": "pnpm --filter @facylf/ingesta ingesta:una",
    "ingesta:vigilar": "pnpm --filter @facylf/ingesta ingesta:vigilar",
    "ingesta:todas": "pnpm --filter @facylf/ingesta ingesta:todas",
    "descubrir-competiciones": "pnpm --filter @facylf/ingesta descubrir",
    "catalogo-historico": "pnpm --filter @facylf/ingesta catalogo-historico",
    "descubrir-grupos": "pnpm --filter @facylf/ingesta descubrir-grupos",
    "reconstruir": "pnpm --filter @facylf/ingesta reconstruir",
    "reconstruir-cola": "tsx scripts/reconstruir-cola.mjs",
    "selenium-poc": "node scripts/selenium-poc.mjs",
    "recolector:preparar": "node scripts/recolector-local.mjs preparar",
    "recolector:estado": "node scripts/recolector-local.mjs estado",
    "recolector:exportar": "node scripts/recolector-local.mjs exportar",
    "recolector:reprocesar": "node scripts/recolector-local.mjs reprocesar",
    "recolector:plan-muestras": "node scripts/recolector-local.mjs plan-muestras",
    "recolector:ejecutar": "node scripts/recolector-local.mjs ejecutar",
    "recolector:arrancar": "node scripts/recolector-local.mjs arrancar",
    "recolector:test": "node --test scripts/lib/acta-sin-datos.test.mjs scripts/lib/acta-vacia.test.mjs scripts/lib/banderas-chrome.test.mjs scripts/lib/calendario-cataluna.test.mjs scripts/lib/clasificacion-cataluna.test.mjs scripts/lib/compose-flota.test.mjs scripts/lib/estado-cola.test.mjs scripts/lib/plan-flota.test.mjs scripts/lib/recolector-local.test.mjs",
    "flota:supervisor": "node scripts/supervisor-flota.mjs",
    "sondeo:extremadura": "node scripts/sondeo-federacion.mjs --url https://www.fexfutbol.com --nombre extremadura --dir descargas-federacion-sondeo",
    "sondeo:galicia": "node scripts/sondeo-federacion.mjs --url https://www.futgal.es --nombre galicia --dir descargas-federacion-sondeo",
    "sondeo:rioja": "node scripts/sondeo-federacion.mjs --url https://www.frfutbol.com --nombre rioja --dir descargas-federacion-sondeo",
    "sondeo:baleares": "node scripts/sondeo-portal.mjs --nombre baleares --url https://www.ffib.es/Fed/",
    "sondeo:cataluna": "node scripts/sondeo-portal.mjs --nombre cataluna --url https://www.fcf.cat/ca/competicio",
    "cataluna:descubrir": "node scripts/recolector-cataluna.mjs descubrir",
    "cataluna:estado": "node scripts/recolector-cataluna.mjs estado",
    "sondeo:melilla": "node scripts/sondeo-federacion.mjs --url https://www.rfmf.es --nombre melilla --dir descargas-federacion-sondeo",
    "recolector:extremadura": "node scripts/recolector-local.mjs arrancar --perfil perfiles/extremadura.json",
    "recolector:galicia": "node scripts/recolector-local.mjs arrancar --perfil perfiles/galicia.json",
    "recolector:rioja": "node scripts/recolector-local.mjs arrancar --perfil perfiles/rioja.json",
    "recolector:extremadura:todo": "pnpm sondeo:extremadura && node scripts/bootstrap-federacion.mjs --perfil perfiles/extremadura.json && node scripts/recolector-local.mjs arrancar --perfil perfiles/extremadura.json",
    "recolector:galicia:todo": "pnpm sondeo:galicia && node scripts/bootstrap-federacion.mjs --perfil perfiles/galicia.json && node scripts/recolector-local.mjs arrancar --perfil perfiles/galicia.json",
    "recolector:rioja:todo": "pnpm sondeo:rioja && node scripts/bootstrap-federacion.mjs --perfil perfiles/rioja.json && node scripts/recolector-local.mjs arrancar --perfil perfiles/rioja.json",
    "sondeo:asturias": "node scripts/sondeo-federacion.mjs --url https://www.asturfutbol.es --nombre asturias --dir descargas-federacion-sondeo",
    "sondeo:aragon": "node scripts/sondeo-federacion.mjs --url https://www.futbolaragon.com --nombre aragon --dir descargas-federacion-sondeo",
    "sondeo:cantabria": "node scripts/sondeo-federacion.mjs --url https://www.rfcf.es --nombre cantabria --dir descargas-federacion-sondeo",
    "recolector:asturias": "node scripts/recolector-local.mjs arrancar --perfil perfiles/asturias.json",
    "recolector:aragon": "node scripts/recolector-local.mjs arrancar --perfil perfiles/aragon.json",
    "recolector:cantabria": "node scripts/recolector-local.mjs arrancar --perfil perfiles/cantabria.json",
    "recolector:asturias:todo": "pnpm sondeo:asturias && node scripts/bootstrap-federacion.mjs --perfil perfiles/asturias.json && node scripts/recolector-local.mjs arrancar --perfil perfiles/asturias.json",
    "recolector:aragon:todo": "pnpm sondeo:aragon && node scripts/bootstrap-federacion.mjs --perfil perfiles/aragon.json && node scripts/recolector-local.mjs arrancar --perfil perfiles/aragon.json",
    "recolector:cantabria:todo": "pnpm sondeo:cantabria && node scripts/bootstrap-federacion.mjs --perfil perfiles/cantabria.json && node scripts/recolector-local.mjs arrancar --perfil perfiles/cantabria.json",
    "sondeo:navarra": "node scripts/sondeo-federacion.mjs --url https://www.futnavarra.es --nombre navarra --dir descargas-federacion-sondeo",
    "sondeo:euskadi": "node scripts/sondeo-federacion.mjs --url https://www.euskadifutbol.eus --nombre euskadi --dir descargas-federacion-sondeo",
    "sondeo:castilla-la-mancha": "node scripts/sondeo-federacion.mjs --url https://www.ffcm.es --nombre castilla-la-mancha --dir descargas-federacion-sondeo",
    "sondeo:andalucia": "node scripts/sondeo-federacion.mjs --url https://www.rfaf.es --nombre andalucia --dir descargas-federacion-sondeo",
    "sondeo:murcia": "node scripts/sondeo-federacion.mjs --url https://www.ffrm.es --nombre murcia --dir descargas-federacion-sondeo",
    "sondeo:canarias": "node scripts/sondeo-federacion.mjs --url https://www.federacioncanariafutbol.es --nombre canarias --dir descargas-federacion-sondeo",
    "sondeo:ceuta": "node scripts/sondeo-federacion.mjs --url https://www.rffce.es --nombre ceuta --dir descargas-federacion-sondeo",
    "sondeo:madrid": "node scripts/sondeo-isquad.mjs --federacion madrid",
    "sondeo:valencia": "node scripts/sondeo-isquad.mjs --federacion valencia",
    "valencia:preparar": "node scripts/recolector-valencia.mjs preparar",
    "valencia:arrancar": "node scripts/recolector-valencia.mjs arrancar",
    "valencia:estado": "node scripts/recolector-valencia.mjs estado",
    "valencia:tarea": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/registrar-tarea-valencia.ps1",
    "madrid:preparar": "node scripts/recolector-madrid.mjs preparar",
    "madrid:arrancar": "node scripts/recolector-madrid.mjs arrancar",
    "madrid:estado": "node scripts/recolector-madrid.mjs estado",
    "madrid:tarea": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/registrar-tarea-madrid.ps1",
    "recolector:navarra": "node scripts/recolector-local.mjs arrancar --perfil perfiles/navarra.json",
    "recolector:euskadi": "node scripts/recolector-local.mjs arrancar --perfil perfiles/euskadi.json",
    "recolector:castilla-la-mancha": "node scripts/recolector-local.mjs arrancar --perfil perfiles/castilla-la-mancha.json",
    "recolector:andalucia": "node scripts/recolector-local.mjs arrancar --perfil perfiles/andalucia.json",
    "recolector:murcia": "node scripts/recolector-local.mjs arrancar --perfil perfiles/murcia.json",
    "recolector:canarias": "node scripts/recolector-local.mjs arrancar --perfil perfiles/canarias.json",
    "recolector:ceuta": "node scripts/recolector-local.mjs arrancar --perfil perfiles/ceuta.json",
    "recolector:melilla": "node scripts/recolector-local.mjs arrancar --perfil perfiles/melilla.json",
    "recolector:navarra:todo": "pnpm sondeo:navarra && node scripts/bootstrap-federacion.mjs --perfil perfiles/navarra.json && pnpm recolector:navarra",
    "recolector:euskadi:todo": "pnpm sondeo:euskadi && node scripts/bootstrap-federacion.mjs --perfil perfiles/euskadi.json && pnpm recolector:euskadi",
    "recolector:castilla-la-mancha:todo": "pnpm sondeo:castilla-la-mancha && node scripts/bootstrap-federacion.mjs --perfil perfiles/castilla-la-mancha.json && pnpm recolector:castilla-la-mancha",
    "recolector:andalucia:todo": "pnpm sondeo:andalucia && node scripts/bootstrap-federacion.mjs --perfil perfiles/andalucia.json && pnpm recolector:andalucia",
    "recolector:murcia:todo": "pnpm sondeo:murcia && node scripts/bootstrap-federacion.mjs --perfil perfiles/murcia.json && pnpm recolector:murcia",
    "recolector:canarias:todo": "pnpm sondeo:canarias && node scripts/bootstrap-federacion.mjs --perfil perfiles/canarias.json && pnpm recolector:canarias",
    "recolector:ceuta:todo": "pnpm sondeo:ceuta && node scripts/bootstrap-federacion.mjs --perfil perfiles/ceuta.json && pnpm recolector:ceuta",
    "recolector:melilla:todo": "pnpm sondeo:melilla && node scripts/bootstrap-federacion.mjs --perfil perfiles/melilla.json && pnpm recolector:melilla",
    "workers:estado": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/estado-workers.ps1",
    "workers:reiniciar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reiniciar-recolectores.ps1",
    "workers:limpiar-pausa": "node scripts/limpiar-pausa.mjs",
    "workers:auditar": "node scripts/auditar-calidad.mjs",
    "workers:reparar-minutos": "node scripts/reparar-minutos-imposibles.mjs --aplicar",
    "temporadas:ventana": "node scripts/aplazar-temporadas-viejas.mjs",
    "oro": "node scripts/oro.mjs",
    "planes": "tsx scripts/planes.mjs",
    "workers:estimar": "node scripts/estimar-tiempos.mjs",
    "visor": "node scripts/visor-workers.mjs",
    "visor:vigilar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ejecutar-visor.ps1",
    "visor:reiniciar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ejecutar-visor.ps1 -Forzar",
    "visor:tarea": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/registrar-tarea-visor.ps1",
    "lint": "tsc -b --noEmit packages/dominio packages/ingesta packages/canonico",
    "db:arrancar": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "db:parar": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:migrar": "node scripts/migrar-canonico.mjs",
    "db:estado": "node scripts/migrar-canonico.mjs --estado",
    "importar": "pnpm --filter @facylf/canonico importar",
    "db:psql": "docker exec -it facylf-postgres psql -U facylf_admin -d facylf",
    "flota:informe": "node scripts/ajustar-flota.mjs",
    "flota:ajustar": "node scripts/ajustar-flota.mjs --aplicar",
    "flota:tarea": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/registrar-tarea-flota.ps1",
    "colas:dia-madrid": "node scripts/migrar-colas-dia-madrid.mjs",
    "turnos:probar": "node scripts/prueba-turnos-docker.mjs --federaciones prueba-a,prueba-b,prueba-c --volumen-datos facylf-datos-prueba --memoria-gb 2 --turno-min 1 --minutos 6"
  },
  "devDependencies": {
    "node-html-parser": "^6.1.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "selenium-webdriver": "^4.46.0"
  }
}
