{
  "title": "Fondo Popular · resumen",
  "uid": "facylf-resumen",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"type":"timeseries","title":"CPU del host","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)","legendFormat":"CPU %"}]},
    {"type":"timeseries","title":"Memoria disponible","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"node_memory_MemAvailable_bytes / 1024 / 1024 / 1024","legendFormat":"GB libres"}]},
    {"type":"timeseries","title":"Conexiones PostgreSQL","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"pg_stat_activity_count","legendFormat":"conexiones"}]},
    {"type":"timeseries","title":"Sonda HTTPS","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"probe_success","legendFormat":"1 = ok"}]}
  ]
}
